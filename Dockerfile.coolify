# Coolify build (Dockerfile build pack, app "moneyprinterturbo" on oracle-hash). Same as the upstream
# Dockerfile but on bookworm: bullseye LTS ended in Aug 2026 and its arm64 security packages 404, so
# upstream's python:3.11-slim-bullseye base no longer builds on the A1 (arm64) VM. Kept as a separate
# file so upstream merges don't conflict.
FROM python:3.11-slim-bookworm

WORKDIR /MoneyPrinterTurbo
RUN chmod 777 /MoneyPrinterTurbo
ENV PYTHONPATH="/MoneyPrinterTurbo"
# config.toml, storage/ (generated videos) and resource/ live here, on Coolify's persistent volume.
ENV MPT_HOME=/data

# curl: Coolify's health check runs inside the container. caddy: the login gate (coolify/Caddyfile).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ffmpeg curl caddy \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir --retries 3 --timeout 60 -r requirements.txt

COPY . .
RUN chmod +x coolify/start.sh

# :8501 is Caddy (login via MPT_AUTH_USER / MPT_AUTH_PASSWORD); Streamlit listens on 127.0.0.1:8502.
EXPOSE 8501
CMD ["./coolify/start.sh"]
